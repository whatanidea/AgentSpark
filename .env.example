# Local default is demo. Set live explicitly to use Azure; restart after changes.
# ENVIRONMENT=production requires AGENTSENSE_MODE to be explicitly set.
AGENTSENSE_MODE=demo
ENVIRONMENT=development

# Local demo is shared and unauthenticated; never expose it publicly.
# Live OR production requires oidc and fails startup without these settings.
# Set AGENTSENSE_AUTH_MODE=oidc when using the HTTPS API with organization tokens.
# Use the exact issuer and the audience of an API-specific access token, not an ID token.
# AGENTSENSE_AUTH_MODE=oidc
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_REVIEWER_ROLE=AgentSense.Reviewer
# Optional browser sign-in (OIDC auth code + PKCE). Set all three or none.
AUTH_SPA_CLIENT_ID=
AUTH_SPA_AUTHORITY=
AUTH_SPA_SCOPE=

# Absolute session lifetime (1-720 hours); updates do not extend it.
SESSION_RETENTION_HOURS=24

# Independent decision snapshot lifetime (1-3650 days); no full interview transcript.
DECISION_ARCHIVE_RETENTION_DAYS=30
# Demo archive defaults to ~/.agentspark/decisions.sqlite3; use fictional data only.
# DEMO_ARCHIVE_PATH=

# Required in live mode. Provision the database/container and seed Search first.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Set for reasoning deployments (gpt-5 family): minimal|low|medium|high. Omits temperature.
AZURE_OPENAI_REASONING_EFFORT=
AZURE_OPENAI_TIMEOUT_SECONDS=15
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=patterns-index
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE_NAME=agentsense_db
# Existing workflows container: partition key /session_id; enable TTL (defaultTtl=-1).
# /ready reports Cosmos unavailable if per-document TTL is disabled.
